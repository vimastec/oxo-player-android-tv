<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>
    </style>
    
    <!-- Netflix-Style Text Styles -->
    <style name="TextAppearance.OXO.HeroTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_hero_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">8</item>
    </style>
    
    <style name="TextAppearance.OXO.SectionTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_section_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.OXO.Navigation" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_nav</item>
        <item name="android:textColor">@color/light_gray</item>
    </style>
    
    <style name="TextAppearance.OXO.Button" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.OXO.CardTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_card_title</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.OXO.CardSubtitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_size_card_subtitle</item>
        <item name="android:textColor">@color/light_gray</item>
    </style>
    
    <!-- Card Styles -->
    <style name="CardView.OXO" parent="CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    
    <style name="CardView.OXO.Hero">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">8dp</item>
    </style>
    
    <style name="CardView.OXO.Category">
        <item name="cardBackgroundColor">@color/dark_gray</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">8dp</item>
    </style>
    
    <!-- Button Styles -->
    <style name="Button.OXO.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
    </style>
    
    <style name="Button.OXO.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/hero_overlay</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
    </style>
    
    <!-- PIN Keypad Button Style -->
    <style name="PinKeyStyle">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/pin_key_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
    </style>
    
    <!-- PopupMenu Style with visible focus for TV remote -->
    <style name="PopupMenu.OXO" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/dark_gray</item>
        <item name="android:dropDownListViewStyle">@style/PopupMenuListView</item>
    </style>
    
    <style name="PopupMenuListView" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:listSelector">@drawable/popup_menu_selector</item>
        <item name="android:divider">@color/gray</item>
        <item name="android:dividerHeight">1dp</item>
    </style>
</resources>

