<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme - NoActionBar to remove gray title bar -->
    <style name="Theme.OXOPlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/black</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- PopupMenu style with visible focus -->
        <item name="popupMenuStyle">@style/PopupMenu.OXO</item>
        <item name="android:popupMenuStyle">@style/PopupMenu.OXO</item>
        <item name="android:dropDownListViewStyle">@style/PopupMenuListView</item>
    </style>
    
    <!-- Leanback theme for TV browsing -->
    <style name="Theme.OXOPlayer.Leanback" parent="Theme.Leanback">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
    
    <!-- Player theme (fullscreen, no action bar) -->
    <style name="Theme.OXOPlayer.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
    
    <!-- Dialog theme with visible focus for TV remote -->
    <style name="Theme.OXOPlayer.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/sidebar_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowTitleStyle">@style/DialogTitleStyle</item>
        <item name="android:listChoiceIndicatorSingle">@drawable/dialog_radio_button</item>
        <item name="android:listSelector">@drawable/dialog_list_selector</item>
        <!-- TV Remote focus visibility -->
        <item name="android:listViewStyle">@style/DialogListView</item>
    </style>
    
    <!-- ListView style for dialog with visible focus -->
    <style name="DialogListView" parent="Widget.AppCompat.ListView">
        <item name="android:listSelector">@drawable/dialog_list_selector</item>
        <item name="android:drawSelectorOnTop">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:cacheColorHint">@android:color/transparent</item>
    </style>
    
    <!-- Dialog item text style - black text on orange focus -->
    <style name="DialogItemText" parent="android:Widget.TextView">
        <item name="android:textColor">@color/dialog_text_color</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
    </style>
    
    <style name="DialogTitleStyle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>

