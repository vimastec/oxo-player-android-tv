<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="horizontal"
    android:padding="32dp"
    android:gravity="center">

    <!-- Left Side - Device Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="32dp">

        <!-- OXO Logo -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:src="@drawable/oxo_logo_new"
            android:scaleType="fitCenter"
            android:contentDescription="OXO Player Logo"
            android:layout_marginBottom="24dp" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vérification de l'appareil..."
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:layout_marginBottom="16dp" />

        <!-- MAC Address -->
        <TextView
            android:id="@+id/macAddressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAC: XX:XX:XX:XX:XX:XX"
            android:textColor="@color/secondary"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <!-- Device Key -->
        <TextView
            android:id="@+id/deviceKeyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Key: ------"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Days Remaining -->
        <TextView
            android:id="@+id/daysRemainingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/primary"
            android:layout_marginBottom="24dp" />

        <!-- Retry Button -->
        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Réessayer"
            android:textSize="16sp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:backgroundTint="@color/primary" />

        <!-- Continue Button -->
        <Button
            android:id="@+id/continueButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continuer"
            android:textSize="16sp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="300dp"
        android:background="@color/dark_gray" />

    <!-- Right Side - Portal Info & QR Code -->
    <LinearLayout
        android:id="@+id/portalInfoSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp">

        <!-- Portal Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Ajouter votre playlist"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scannez le QR code avec votre téléphone\nou visitez le site web pour ajouter vos playlists"
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- QR Code -->
        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="QR Code Portal" />

        <!-- Portal URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="oxo-portal.web.app"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Instructions Steps -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/dark_gray">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1️⃣ Scannez le QR code"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2️⃣ Entrez MAC + Device Key"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3️⃣ Ajoutez vos playlists"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4️⃣ Redémarrez l'application"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Change Playlist Button -->
        <Button
            android:id="@+id/changePlaylistButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Changer de playlist"
            android:textSize="14sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/secondary"
            android:visibility="gone"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
