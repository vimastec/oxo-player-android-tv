<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Netflix-style Bottom Controls Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/player_controls_background"
        android:paddingBottom="16dp">

        <!-- Progress Bar Row (Netflix style with red scrubber) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Current Position Time -->
            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E50914"
                android:textSize="14sp"
                android:textStyle="bold"
                android:minWidth="50dp"
                android:gravity="start" />

            <!-- Netflix-style Progress Bar (Red scrubber) -->
            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                app:played_color="#E50914"
                app:unplayed_color="#4D4D4D"
                app:buffered_color="#808080"
                app:scrubber_color="#E50914"
                app:scrubber_enabled_size="16dp"
                app:scrubber_disabled_size="0dp"
                app:scrubber_dragged_size="20dp"
                app:bar_height="4dp"
                app:touch_target_height="28dp" />

            <!-- Duration / Time Remaining -->
            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:minWidth="50dp"
                android:gravity="end" />

        </LinearLayout>

        <!-- Main Controls Row (Netflix layout) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp">

            <!-- LEFT CONTROLS: Play, -10s, +10s, Volume -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <!-- Play/Pause Button -->
                <ImageButton
                    android:id="@+id/exo_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:src="@drawable/ic_netflix_play"
                    android:contentDescription="Play/Pause"
                    android:focusable="true"
                    android:nextFocusLeft="@id/exo_play_pause"
                    android:nextFocusRight="@+id/exo_rew"
                    android:nextFocusUp="@id/exo_progress" />

                <!-- Rewind -10s Button -->
                <ImageButton
                    android:id="@+id/exo_rew"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="4dp"
                    android:src="@drawable/ic_netflix_rewind_10"
                    android:contentDescription="Rewind 10s"
                    android:focusable="true"
                    android:nextFocusLeft="@id/exo_play_pause"
                    android:nextFocusRight="@id/exo_ffwd"
                    android:nextFocusUp="@id/exo_progress" />

                <!-- Forward +10s Button -->
                <ImageButton
                    android:id="@+id/exo_ffwd"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="4dp"
                    android:src="@drawable/ic_netflix_forward_10"
                    android:contentDescription="Forward 10s"
                    android:focusable="true"
                    android:nextFocusLeft="@id/exo_rew"
                    android:nextFocusRight="@+id/btn_volume"
                    android:nextFocusUp="@id/exo_progress" />

                <!-- Volume Button -->
                <ImageButton
                    android:id="@+id/btn_volume"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:src="@drawable/ic_netflix_volume"
                    android:contentDescription="Volume"
                    android:focusable="true"
                    android:nextFocusLeft="@id/exo_ffwd"
                    android:nextFocusRight="@+id/btn_next_episode"
                    android:nextFocusUp="@id/exo_progress" />

            </LinearLayout>

            <!-- CENTER: Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center" />

            </LinearLayout>

            <!-- RIGHT CONTROLS: Next Episode, Episodes, Subtitles, Audio -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <!-- Next Episode Button -->
                <ImageButton
                    android:id="@+id/btn_next_episode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:src="@drawable/ic_netflix_next_episode"
                    android:contentDescription="Next Episode"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusLeft="@id/btn_volume"
                    android:nextFocusRight="@+id/btn_episodes"
                    android:nextFocusUp="@id/exo_progress" />

                <!-- Episodes Button (Series only) -->
                <ImageButton
                    android:id="@+id/btn_episodes"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:src="@drawable/ic_netflix_episodes"
                    android:contentDescription="Episodes"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusLeft="@+id/btn_next_episode"
                    android:nextFocusRight="@+id/btn_subtitles"
                    android:nextFocusUp="@id/exo_progress" />

                <!-- Subtitles Button -->
                <ImageButton
                    android:id="@+id/btn_subtitles"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:src="@drawable/ic_netflix_subtitles"
                    android:contentDescription="Subtitles"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btn_episodes"
                    android:nextFocusRight="@+id/btn_audio"
                    android:nextFocusUp="@id/exo_progress" />

                <!-- Audio Button -->
                <ImageButton
                    android:id="@+id/btn_audio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:src="@drawable/ic_netflix_audio"
                    android:contentDescription="Audio"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btn_subtitles"
                    android:nextFocusRight="@id/btn_audio"
                    android:nextFocusUp="@id/exo_progress" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
