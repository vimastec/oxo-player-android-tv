<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark">

    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="32dp"
        android:elevation="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🎉 Nouvelle version disponible"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Version Info -->
        <TextView
            android:id="@+id/currentVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Version actuelle: 1.5.8" />

        <TextView
            android:id="@+id/newVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            tools:text="Nouvelle version: 1.5.9" />

        <!-- Changelog -->
        <TextView
            android:id="@+id/changelogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/changelog_background"
            android:padding="12dp"
            android:maxLines="6"
            android:ellipsize="end"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            tools:text="- Amélioration des performances\n- Correction de bugs\n- Nouvelle fonctionnalité X" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/card"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="45%" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            tools:text="Téléchargement en cours..." />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/laterButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Plus tard"
                android:textColor="@color/white"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/downloadButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Télécharger"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary"
                android:layout_marginStart="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/installButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Installer"
                android:textColor="@color/white"
                android:background="@drawable/btn_success"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>


