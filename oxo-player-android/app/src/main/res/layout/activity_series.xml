<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left Sidebar - Categories -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="@color/sidebar_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Séries"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:background="@color/primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoriesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Main Content Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:clipChildren="false">

            <!-- Header with Year Filter and Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:padding="12dp"
                android:background="#222222">

                <!-- Hidden category title (kept for code compatibility) -->
                <TextView
                    android:id="@+id/categoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Year Filter Spinner -->
                <Spinner
                    android:id="@+id/yearFilterSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="180dp"
                    android:background="@drawable/search_background_focusable"
                    android:popupBackground="#333333"
                    android:dropDownWidth="180dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginEnd="16dp"
                    android:focusable="true" />

                <!-- Search Bar -->
                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="320dp"
                    android:layout_height="48dp"
                    android:background="@drawable/search_background_focusable"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/light_gray"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="🔍 Rechercher une série..."
                    android:textColor="@android:color/white"
                    android:textColorHint="@color/light_gray"
                    android:textSize="15sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:focusable="true" />

                <!-- Hidden clear button (kept for code compatibility) -->
                <ImageView
                    android:id="@+id/clearSearchButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Series Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/seriesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="80dp"
                    android:paddingBottom="16dp" />

                <!-- No Results Text -->
                <TextView
                    android:id="@+id/noResultsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Aucune série trouvée"
                    android:textColor="@color/light_gray"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/primary" />

</FrameLayout>
