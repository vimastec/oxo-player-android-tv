<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:elevation="10dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminateTint="@color/primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chargement du contenu..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loadingSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live TV, Films et Séries"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with Logo and Navigation -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="32dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- OXO Logo -->
                    <ImageView
                        android:id="@+id/oxoLogo"
                        android:layout_width="160dp"
                        android:layout_height="60dp"
                        android:src="@drawable/oxo_logo_new"
                        android:scaleType="fitCenter"
                        android:contentDescription="OXO Player Logo" />

                    <!-- Navigation Menu -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="48dp"
                        android:orientation="horizontal"
                        android:gravity="start">

                        <TextView
                            android:id="@+id/navHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/navLiveTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live TV"
                            android:textColor="@color/light_gray"
                            android:textSize="18sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/navMovies"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Films"
                            android:textColor="@color/light_gray"
                            android:textSize="18sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/navSeries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Séries"
                            android:textColor="@color/light_gray"
                            android:textSize="18sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />
                    </LinearLayout>

                    <!-- User Account & Settings -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/btnSearch"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_search"
                            android:layout_marginEnd="20dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:contentDescription="Search" />

                        <ImageView
                            android:id="@+id/btnSettings"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_home_settings"
                            android:layout_marginEnd="20dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:contentDescription="Settings" />

                        <!-- Profile Section -->
                        <LinearLayout
                            android:id="@+id/profileSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:focusable="true"
                            android:clickable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/profileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profil"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:layout_marginEnd="12dp" />

                            <androidx.cardview.widget.CardView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                app:cardCornerRadius="22dp"
                                app:cardElevation="4dp"
                                app:cardBackgroundColor="@color/dark_gray">

                                <ImageView
                                    android:id="@+id/profileAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_home_account" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Featured Hero Banner -->
            <FrameLayout
                android:id="@+id/heroBanner"
                android:layout_width="match_parent"
                android:layout_height="580dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/hero_gradient">

                <!-- Hero Background Image -->
                <ImageView
                    android:id="@+id/heroBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_background"
                    android:alpha="0.5" />

                <!-- Hero Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="64dp">

                    <!-- Featured Label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_featured"
                            android:tint="@color/primary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EN VEDETTE"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                    </LinearLayout>

                    <!-- Hero Title -->
                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bienvenue sur OXO Player"
                        android:textColor="@color/white"
                        android:textSize="56sp"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:layout_marginBottom="16dp"
                        android:maxWidth="800dp" />

                    <!-- Hero Description -->
                    <TextView
                        android:id="@+id/heroDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profitez de milliers de chaînes en direct, films et séries. Votre divertissement illimité commence ici."
                        android:textColor="@color/light_gray"
                        android:textSize="20sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="32dp"
                        android:maxWidth="700dp" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnPlayNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="8dp"
                            android:layout_marginEnd="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="32dp"
                                android:paddingEnd="32dp"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_play"
                                    android:tint="@color/black"
                                    android:layout_marginEnd="12dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Regarder maintenant"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnMoreInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#80FFFFFF"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="32dp"
                                android:paddingEnd="32dp"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_info"
                                    android:tint="@color/white"
                                    android:layout_marginEnd="12dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Plus d'infos"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Content Rows -->
            
            <!-- Continue Watching Movies Row -->
            <LinearLayout
                android:id="@+id/continueMoviesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶️ Continuer les Films"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/continueMoviesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Continue Watching Series Row -->
            <LinearLayout
                android:id="@+id/continueSeriesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶️ Continuer les Séries"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/continueSeriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Recent Live TV Channels Row -->
            <LinearLayout
                android:id="@+id/recentChannelsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 Dernières Chaînes Regardées"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentChannelsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Live TV Channels Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺 Chaînes en Direct"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/liveChannelsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>

            <!-- Popular Movies Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 Films Populaires"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/moviesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>

            <!-- Series Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺 Séries à Regarder"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/seriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>

            <!-- Quick Access Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="48dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗂️ Catégories"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:gravity="center_horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/categoryAction"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/dark_gray"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎬"
                                android:textSize="40sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Action"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/categoryComedy"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/dark_gray"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="😂"
                                android:textSize="40sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comédie"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/categoryDrama"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/dark_gray"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎭"
                                android:textSize="40sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Drame"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/categorySport"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/dark_gray"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚽"
                                android:textSize="40sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sport"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Status Bar at Bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp"
                android:background="@color/dark_gray">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Playlist expires: --"
                    android:textColor="@color/light_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/light_gray"
                    android:textSize="14sp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0.0"
                    android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>