<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:elevation="10dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminateTint="@color/primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chargement du contenu..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loadingSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live TV, Films et Séries"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with Logo and Navigation -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="32dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- OXO Logo -->
                    <ImageView
                        android:id="@+id/oxoLogo"
                        android:layout_width="160dp"
                        android:layout_height="60dp"
                        android:src="@drawable/oxo_logo_new"
                        android:scaleType="fitCenter"
                        android:contentDescription="OXO Player Logo" />

                    <!-- Navigation Menu -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="48dp"
                        android:orientation="horizontal"
                        android:gravity="start">

                        <TextView
                            android:id="@+id/navHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Home"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/navLiveTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live TV"
                            android:textColor="@color/light_gray"
                            android:textSize="18sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/navMovies"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Films"
                            android:textColor="@color/light_gray"
                            android:textSize="18sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/navSeries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Séries"
                            android:textColor="@color/light_gray"
                            android:textSize="18sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true" />
                    </LinearLayout>

                    <!-- User Account & Settings -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/btnSearch"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_search"
                            android:layout_marginEnd="20dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:contentDescription="Search" />

                        <ImageView
                            android:id="@+id/btnSettings"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_home_settings"
                            android:layout_marginEnd="20dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:contentDescription="Settings" />

                        <!-- Profile Section -->
                        <LinearLayout
                            android:id="@+id/profileSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:focusable="true"
                            android:clickable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/profileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profil"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:layout_marginEnd="12dp" />

                            <androidx.cardview.widget.CardView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                app:cardCornerRadius="22dp"
                                app:cardElevation="4dp"
                                app:cardBackgroundColor="@color/dark_gray">

                                <ImageView
                                    android:id="@+id/profileAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_home_account" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Featured Hero Banner - Netflix Style -->
            <FrameLayout
                android:id="@+id/heroBanner"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:layout_marginTop="16dp">

                <!-- Hero Background Image (Movie Poster) -->
                <ImageView
                    android:id="@+id/heroBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_background" />

                <!-- Hero Video Preview Player (hidden by default) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/heroVideoPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="false"
                    app:resize_mode="zoom"
                    app:surface_type="texture_view" />

                <!-- Gradient Overlay for better text readability -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient_overlay" />

                <!-- Hero Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="48dp">

                    <!-- OXO Logo / Featured Label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OXO"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" FILM"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                    </LinearLayout>

                    <!-- Hero Movie Title -->
                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chargement..."
                        android:textColor="@color/white"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:layout_marginBottom="12dp"
                        android:maxWidth="700dp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Movie Info (Year, Rating, Duration) -->
                    <LinearLayout
                        android:id="@+id/heroInfoLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/heroYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2024"
                            android:textColor="@color/light_gray"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/light_gray" />

                        <TextView
                            android:id="@+id/heroRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 8.5"
                            android:textColor="@color/light_gray"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/light_gray" />

                        <TextView
                            android:id="@+id/heroCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Action"
                            android:textColor="@color/light_gray"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Hero Description -->
                    <TextView
                        android:id="@+id/heroDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/light_gray"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="24dp"
                        android:maxWidth="600dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:visibility="gone" />

                    <!-- Action Buttons - Netflix Style -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Play Button -->
                        <Button
                            android:id="@+id/btnHeroPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:minWidth="150dp"
                            android:text="▶  Regarder"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_hero_play"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:layout_marginEnd="12dp"
                            android:focusable="true"
                            android:elevation="4dp" />

                        <!-- Trailer Button -->
                        <Button
                            android:id="@+id/btnHeroTrailer"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:minWidth="140dp"
                            android:text="Trailer"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_hero_info"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:layout_marginEnd="12dp"
                            android:focusable="true"
                            android:visibility="gone"
                            android:elevation="4dp" />

                        <!-- More Info Button -->
                        <Button
                            android:id="@+id/btnHeroInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:minWidth="150dp"
                            android:text="ⓘ  Plus d'infos"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_hero_info"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:focusable="true"
                            android:elevation="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Content Rows -->

            <!-- Top 10 Films Row (Netflix style) -->
            <LinearLayout
                android:id="@+id/top10MoviesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/top10MoviesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 10 Films cette semaine"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/top10MoviesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Top 10 Séries Row (Netflix style) -->
            <LinearLayout
                android:id="@+id/top10SeriesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/top10SeriesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 10 Séries cette semaine"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/top10SeriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:orientation="horizontal" />
            </LinearLayout>
            
            <!-- My List Section -->
            <LinearLayout
                android:id="@+id/myListSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📌 Ma Liste"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/myListRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Continue Watching Movies Row -->
            <LinearLayout
                android:id="@+id/continueMoviesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶️ Continuer les Films"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/continueMoviesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Continue Watching Series Row -->
            <LinearLayout
                android:id="@+id/continueSeriesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶️ Continuer les Séries"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/continueSeriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Recent Live TV Channels Row -->
            <LinearLayout
                android:id="@+id/recentChannelsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 Dernières Chaînes Regardées"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentChannelsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>
            
            <!-- Live TV Channels Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <!-- Title with Category Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chaînes en Direct"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnLiveCategorySelector"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:text="Toutes ▼"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:background="@drawable/btn_category_selector"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:focusable="true" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/liveChannelsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>

            <!-- Popular Movies Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <!-- Title with Category Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Films Populaires"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnMovieCategorySelector"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:text="Toutes ▼"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:background="@drawable/btn_category_selector"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:focusable="true" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/moviesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>

            <!-- Series Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <!-- Title with Category Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Séries à Regarder"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSeriesCategorySelector"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:text="Toutes ▼"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:background="@drawable/btn_category_selector"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:focusable="true" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/seriesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp" />
            </LinearLayout>


            <!-- Status Bar at Bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp"
                android:background="@color/dark_gray">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Playlist expires: --"
                    android:textColor="@color/light_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/light_gray"
                    android:textSize="14sp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.5.2"
