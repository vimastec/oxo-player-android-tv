<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Text becomes black when focused (visible on orange background) -->
    <item android:state_focused="true" android:color="#000000" />
    <item android:state_pressed="true" android:color="#000000" />
    <item android:state_selected="true" android:color="#000000" />
    <item android:state_activated="true" android:color="#000000" />
    <!-- Default white text -->
    <item android:color="#FFFFFF" />
</selector>





